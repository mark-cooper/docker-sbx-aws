# syntax=docker/dockerfile:1
FROM docker/sandbox-templates:codex@sha256:a68b972a59148c6359ade441387159033f6d196d48aef9dda06d2d4bb26eb41e AS base
FROM node:26.10.0-bookworm-slim@sha256:662933cf47f013bc8e4beb31a6116448427a82057ba7c42c97e4c5ba766504c2 AS node
FROM amazon/aws-cli:2.37.8@sha256:420ab345e847291b541b45d989535f55bcff957c27fa1100fae4aa233e86398c AS aws
FROM jdxcode/mise:debian@sha256:8544c3c5648d98e93b22389ed8d208ec9470a2c92b027de85bb2dc4ed4545cb8 AS mise

FROM base
USER root
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=mise /usr/local/bin/mise /usr/local/bin/mise
COPY --from=aws /usr/local/aws-cli /usr/local/aws-cli
COPY sandbox/bootstrap.ts /opt/readonly-sandbox/bootstrap.ts
RUN ln -sf /usr/local/aws-cli/v2/current/bin/aws /usr/local/bin/aws \
 && apt-get update \
 && apt-get install -y --no-install-recommends libatomic1 \
 && rm -rf /var/lib/apt/lists/*
RUN node --version && aws --version && git --version && jq --version && mise --version
USER agent
WORKDIR /home/agent/workspace
